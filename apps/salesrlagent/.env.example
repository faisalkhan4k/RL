# Local storefront
DEEPGRAM_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
SALES_STT_MODEL=nova-3
SALES_TTS_MODEL=aura-2-thalia-en
SALES_VOICE_MAX_SECONDS=180
SALES_DB_PATH=data/sales.sqlite3
SALES_SECURE_COOKIES=false
SALES_VOSK_MODEL_PATH=data/models/vosk-model-small-en-us-0.15
SALES_PIPER_MODEL_PATH=data/models/piper/en_US-lessac-medium.onnx

# Optional conversion checkpoint. Train before enabling.
# SALES_MODEL_PATH=artifacts/conversion-smoke.pt
# Superseded by separate discrete action policies:
# SALES_STRATEGY_POLICY=artifacts/hrl/strategy.zip
# SALES_VOICE_POLICY=artifacts/hrl/voice.zip
# Optional OpenAI-compatible chat-completions endpoint (wording only).
# SALES_LLM_URL=https://your-provider.example/v1/chat/completions
# SALES_LLM_MODEL=your-model
# SALES_LLM_KEY=
# SALES_DATABASE_URL=postgresql://sales:password@localhost:5432/sales

# Optional OpenTelemetry collector.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Set both behind HTTPS when deploying later.
# SALES_PUBLIC_ORIGIN=https://shop.example.com
# SALES_SECURE_COOKIES=true

# Optional paid semantic embeddings. Leave unset for local hash-based smoke tests.
# SALES_EMBEDDING_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com/openai/v1/embeddings
# SALES_EMBEDDING_MODEL=YOUR-text-embedding-3-large-deployment
# SALES_EMBEDDING_API_KEY=
